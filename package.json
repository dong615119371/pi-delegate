{
  "name": "pi-delegate",
  "version": "0.1.0",
  "description": "Outsource work to the OpenCode CLI. Synchronous by default; gains a background delegate when the async-jobs host is installed.",
  "keywords": [
    "pi-package",
    "pi",
    "opencode",
    "delegate",
    "outsource"
  ],
  "license": "MIT",
  "author": "白遇冬夏",
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "index.ts",
    "delegate.ts",
    "channel.ts",
    "consumer.ts",
    "cli.ts",
    "models.ts",
    "skills/**/*.md",
    "README.md",
    "LICENSE",
    "README.en.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dong615119371/pi-delegate.git"
  },
  "homepage": "https://github.com/dong615119371/pi-delegate#readme",
  "bugs": {
    "url": "https://github.com/dong615119371/pi-delegate/issues"
  }
}
